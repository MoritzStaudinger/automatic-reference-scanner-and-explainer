# Copy to .env and fill in the values you actually have.
# All keys are optional — the pipeline degrades gracefully when a source
# is unavailable.  More keys → fewer rate-limit walls.

# ── Lookup sources ──────────────────────────────────────────────────────
# Semantic Scholar: https://www.semanticscholar.org/product/api#api-key-form
# Without a key S2 still works but is rate-limited (1 req/s shared bucket).
S2_API_KEY=

# CORE: https://api.core.ac.uk/  (free key, ~1 req/s)
# Used only as a rescue lookup when the standard sources find nothing.
CORE_API_KEY=

# Polite-pool identifier for OpenAlex.  An email here unlocks higher rate
# limits.  Leave blank to use OpenAlex's anonymous pool.
OPENALEX_MAILTO=

# ── LLM repair (optional but recommended) ───────────────────────────────
# Two backends supported:
#   anthropic — Claude via the Anthropic API
#   aqueduct  — OpenAI-compatible endpoint at TU Wien's DataLab
LLM_BACKEND=anthropic
LLM_MODEL=claude-sonnet-4-6

# Anthropic
ANTHROPIC_API_KEY=

# Aqueduct (TU Wien DataLab — internal)
AQUEDUCT_API_KEY=
AQUEDUCT_BASE_URL=
AQUEDUCT_TIMEOUT=120

# Throughput tuning
LLM_BATCH_SIZE=20
LLM_PARALLEL=8

# Per-call timeout for claim-verification LLM calls (seconds).  Aqueduct/
# Qwen on shared TU Wien GPU can hang for tens of minutes under cluster
# contention — a hard cap keeps one stuck ref from freezing the whole
# pipeline.  Set higher (e.g. 300) if you're on a fast dedicated backend
# and want to give it more room; lower (e.g. 60) if you'd rather drop
# stuck calls fast and move on.
LLM_VERIFY_TIMEOUT_S=90

# ── Infrastructure ──────────────────────────────────────────────────────
# GROBID HTTP endpoint.  When you run via docker-compose this is set
# automatically to http://grobid:8070 — only override for local dev where
# you point at a different GROBID host.
GROBID_URL=http://localhost:8070

# SQLite cache for lookup results.  Survives container restarts.
ARES_CACHE=./data/cache.sqlite

# Custom PDF selector (JS overlay with native text selection).  Set to 0
# to fall back to the streamlit-pdf-viewer component.
ARES_PDF_SELECTOR=1

# ── HTTP API (api.py, ares-api container) ───────────────────────────────
# Single-shared-key path (legacy / quick start).  Set a non-empty value
# and every /api/* request must carry X-API-Key: <this value>.
# When BOTH this AND the keys file (below) are empty the API runs
# unauthenticated — fine for dev, not for production.
ARES_API_KEY=

# Multi-user path.  JSON file with {key: {label, created_at, expires_at?}}.
# Manage with `python scripts/manage_keys.py add <label>`.
# The running API reloads on file mtime change — no restart needed.
ARES_API_KEYS_FILE=./data/api_keys.json

# Background workers for batch processing.  GROBID is the bottleneck — on
# a 2-core VM keep this at 1-2; on a 4+ core VM try 4.
ARES_API_WORKERS=2

# Per-request batch ceiling.  Returns HTTP 400 above this.
ARES_API_MAX_BATCH=500

# SQLite store for batch jobs (status + per-PDF results).  Survives restarts.
ARES_JOBS_DB=./data/jobs.sqlite
